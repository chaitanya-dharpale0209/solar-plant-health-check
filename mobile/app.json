{
  "expo": {
    "name": "Oorjan",
    "slug": "oorjan",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0b0f19",
    "primaryColor": "#f59e0b",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oorjan.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.oorjan.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Oorjan — Solar Plant Diagnostics"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "050cf33b-997b-4960-a60f-58381be70d57"
      }
    }
  }
}
